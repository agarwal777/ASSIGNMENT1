{
  "services": {
    "web": {
      "root": "web/"
    },
    "py": {
      "root": "py/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/py/(.*)",
      "destination": {
        "service": "py"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/py/refresh",
      "schedule": "0 14 * * *"
    }
  ]
}
